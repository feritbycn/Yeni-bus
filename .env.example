# Copy to .env.local. NEVER commit real keys.
# Ad provider (Android build only; web build uses the labelled TEST adapter)
VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_REWARDED_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Server that verifies purchases and rewarded-ad callbacks (not included in this repo)
VITE_BACKEND_URL=https://your-backend.example.com
# Set by CI for GitHub Pages: /<repo-name>/
BASE_PATH=./
