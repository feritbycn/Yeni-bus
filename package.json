{
  "name": "roadmaster-bus-empire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoadMaster: Bus Empire - modular 3D bus simulation and company management game (Three.js + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "three": "^0.170.0"
  }
}
